{
  "name": "hms",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24.11.1 <25"
  },
  "scripts": {
    "lint": "eslint \"apps/**/*.{js,mjs,cjs,ts,tsx}\" \"packages/**/*.{js,mjs,cjs,ts,tsx}\" \"*.{js,mjs,cjs,ts,tsx}\"",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "test": "pnpm --recursive --if-present test",
    "test:watch": "pnpm --recursive --parallel --if-present test:watch",
    "build": "pnpm --recursive --if-present build",
    "dev": "pnpm --recursive --parallel --if-present dev",
    "format": "prettier --write \"apps/**/*.{js,mjs,cjs,ts,tsx,json,yaml,yml,md}\" \"packages/**/*.{js,mjs,cjs,ts,tsx,json,yaml,yml,md}\" \"*.{js,mjs,cjs,ts,tsx,json,yaml,yml,md}\" \".github/workflows/*.{yaml,yml}\"",
    "format:check": "prettier --check \"apps/**/*.{js,mjs,cjs,ts,tsx,json,yaml,yml,md}\" \"packages/**/*.{js,mjs,cjs,ts,tsx,json,yaml,yml,md}\" \"*.{js,mjs,cjs,ts,tsx,json,yaml,yml,md}\" \".github/workflows/*.{yaml,yml}\""
  },
  "pnpm": {
    "overrides": {
      "multer": "2.5.0"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
