# Explicit browser origins only; leave empty to disable cross-origin browser access.
API_CORS_ORIGINS=http://localhost:3000

# Per-client defaults. The API does not trust forwarded proxy headers by default.
API_RATE_LIMIT_MAX=60
API_RATE_LIMIT_TTL_MS=60000

# Local synthetic PostgreSQL only; never use these credentials in production.
DATABASE_URL=postgresql://hms_dev:hms_dev_only@127.0.0.1:5433/hms
