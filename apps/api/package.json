{
  "name": "@hms/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "pnpm prisma:generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "tsx --test src/di.test.ts src/health.test.ts src/main.test.ts src/security.test.ts src/common/validation/zod-validation.pipe.test.ts",
    "test:watch": "tsx --test --watch src/di.test.ts src/health.test.ts src/main.test.ts src/security.test.ts src/common/validation/zod-validation.pipe.test.ts",
    "typecheck": "pnpm prisma:generate && tsc --noEmit -p tsconfig.json",
    "prisma:generate": "prisma generate --config ../../database/prisma.config.ts",
    "prisma:validate": "prisma validate --config ../../database/prisma.config.ts",
    "test:db": "pnpm prisma:generate && prisma migrate deploy --config ../../database/prisma.config.ts && tsx --test src/database/database.integration.test.ts src/bookings/booking.integration.test.ts",
    "test:db:ephemeral": "node ../../scripts/test-db-ephemeral.mjs"
  },
  "dependencies": {
    "@nestjs/common": "11.1.29",
    "@nestjs/core": "11.1.29",
    "@nestjs/platform-express": "11.1.29",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "prisma": "7.10.1",
    "tsx": "4.23.15"
  }
}
