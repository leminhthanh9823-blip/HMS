generator client {
  provider = "prisma-client"
  output   = "../../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PropertyStatus {
  Draft
  Active
  Suspended
  Closed
}

enum BookingStatus {
  Tentative
  Expired
  Cancelled
}

enum RoomNightStatus {
  Active
  Released
}

model Property {
  id           String         @id @db.Uuid
  code         String         @unique @db.VarChar(32)
  name         String         @db.VarChar(160)
  timezone     String         @db.VarChar(128)
  status       PropertyStatus @default(Draft)
  businessDate DateTime       @map("business_date") @db.Date
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  roomTypes    RoomType[]
  rooms        Room[]
  bookings     Booking[]

  @@map("properties")
}

model RoomType {
  id           String             @db.Uuid
  propertyId   String             @map("property_id") @db.Uuid
  code         String             @db.VarChar(32)
  name         String             @db.VarChar(120)
  saleUnitKind String             @map("sale_unit_kind") @db.VarChar(32)
  property     Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  rooms        Room[]
  capacities   RoomTypeCapacity[]
  roomNights   RoomNight[]

  @@id([id, propertyId])
  @@unique([propertyId, code])
  @@map("room_types")
}

model Room {
  id         String      @db.Uuid
  propertyId String      @map("property_id") @db.Uuid
  roomTypeId String      @map("room_type_id") @db.Uuid
  code       String      @db.VarChar(32)
  name       String      @db.VarChar(120)
  property   Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomType   RoomType    @relation(fields: [roomTypeId, propertyId], references: [id, propertyId], onDelete: Cascade)
  roomNights RoomNight[]

  @@id([id, propertyId])
  @@unique([propertyId, code])
  @@map("rooms")
}

model RoomTypeCapacity {
  propertyId String   @map("property_id") @db.Uuid
  roomTypeId String   @map("room_type_id") @db.Uuid
  stayDate   DateTime @map("stay_date") @db.Date
  capacity   Int
  sold       Int      @default(0)
  roomType   RoomType @relation(fields: [roomTypeId, propertyId], references: [id, propertyId], onDelete: Cascade)

  @@id([roomTypeId, stayDate])
  @@map("room_type_capacities")
}

model Booking {
  id             String        @db.Uuid
  propertyId     String        @map("property_id") @db.Uuid
  code           String        @db.VarChar(32)
  idempotencyKey String        @map("idempotency_key") @db.VarChar(128)
  requestHash    String        @map("request_hash") @db.Char(64)
  arrival        DateTime      @db.Date
  departure      DateTime      @db.Date
  status         BookingStatus @default(Tentative)
  holdExpiresAt  DateTime      @map("hold_expires_at") @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  property       Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomNights     RoomNight[]

  @@id([id, propertyId])
  @@unique([propertyId, code])
  @@unique([propertyId, idempotencyKey])
  @@map("bookings")
}

model RoomNight {
  id            String          @id @db.Uuid
  propertyId    String          @map("property_id") @db.Uuid
  bookingId     String          @map("booking_id") @db.Uuid
  roomId        String          @map("room_id") @db.Uuid
  roomTypeId    String          @map("room_type_id") @db.Uuid
  stayDate      DateTime        @map("stay_date") @db.Date
  status        RoomNightStatus @default(Active)
  holdExpiresAt DateTime        @map("hold_expires_at") @db.Timestamptz(6)
  booking       Booking         @relation(fields: [bookingId, propertyId], references: [id, propertyId], onDelete: Cascade)
  room          Room            @relation(fields: [roomId, propertyId], references: [id, propertyId], onDelete: Cascade)
  roomType      RoomType        @relation(fields: [roomTypeId, propertyId], references: [id, propertyId], onDelete: Cascade)

  @@map("room_nights")
}
